#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
repository=${TCTL_REPOSITORY:-jovalle/technis}
version=${TCTL_VERSION:-latest}
[[ $repository =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
  echo 'Invalid TCTL_REPOSITORY' >&2
  exit 2
}
[[ $version =~ ^[A-Za-z0-9_.-]+$ ]] || {
  echo 'Invalid TCTL_VERSION' >&2
  exit 2
}

case $(uname -s) in
  Darwin) platform=apple-darwin ;;
  Linux) platform=unknown-linux-musl ;;
  *)
    echo 'tctl supports macOS and Linux.' >&2
    exit 1
    ;;
esac
case $(uname -m) in
  arm64 | aarch64) architecture=aarch64 ;;
  x86_64 | amd64) architecture=x86_64 ;;
  *)
    echo 'tctl supports arm64 and x86_64.' >&2
    exit 1
    ;;
esac
asset="tctl-${architecture}-${platform}.tar.gz"
mkdir -p "$root/bin"
staging=$(mktemp -d "$root/bin/.prepare.XXXXXX")
trap 'rm -rf "$staging"' EXIT

build_source() {
  command -v cargo >/dev/null || {
    echo 'No release is available yet. Install Rust, then run make build, or retry make after CI publishes a release.' >&2
    exit 1
  }
  (cd "$root" && cargo build --locked --release --bin tctl)
  cp "$root/target/release/tctl" "$staging/tctl"
}

if [[ ${1:-} == --source ]]; then
  build_source
elif [[ $# -gt 0 ]]; then
  echo 'Usage: bash scripts/tctl/prepare [--source]' >&2
  exit 2
else
  command -v curl >/dev/null || {
    echo 'Install curl first.' >&2
    exit 1
  }
  if [[ $version == latest ]]; then
    base="https://github.com/$repository/releases/latest/download"
  else
    base="https://github.com/$repository/releases/download/$version"
  fi
  # Pin both downloads to the same release URL, even if latest changes mid-install.
  result=$(curl --silent --show-error --location --proto '=https' --proto-redir '=https' \
    --connect-timeout 10 --max-time 90 --output "$staging/SHA256SUMS" \
    --write-out '%{http_code} %{url_effective}' "$base/SHA256SUMS")
  code=${result%% *}
  if [[ $code == 404 && $version == latest ]]; then
    echo 'First release not published yet; building the checked-out source.' >&2
    build_source
  else
    [[ $code == 200 ]] || {
      echo "Release lookup failed (HTTP $code). Existing binary was not changed. For a private repository use make build." >&2
      exit 1
    }
    # SHA256SUMS also records the immutable tag. Do not derive a download URL from an asset CDN redirect.
    tag=$(sed -n 's/^# release: //p' "$staging/SHA256SUMS")
    [[ $tag =~ ^tctl-[A-Za-z0-9_.-]+$ ]] || {
      echo 'Invalid release manifest.' >&2
      exit 1
    }
    expected=$(awk -v name="$asset" '$2 == name { print $1 }' "$staging/SHA256SUMS")
    [[ $expected =~ ^[a-f0-9]{64}$ ]] || {
      echo "Release has no checksum for $asset" >&2
      exit 1
    }
    curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
      --connect-timeout 10 --max-time 180 --output "$staging/$asset" \
      "https://github.com/$repository/releases/download/$tag/$asset"
    if command -v sha256sum >/dev/null; then
      actual=$(sha256sum "$staging/$asset")
    else
      actual=$(shasum -a 256 "$staging/$asset")
    fi
    [[ ${actual%% *} == "$expected" ]] || {
      echo 'Checksum mismatch. Existing binary was not changed.' >&2
      exit 1
    }
    [[ $(tar -tzf "$staging/$asset") == tctl ]] || {
      echo 'Unexpected archive contents.' >&2
      exit 1
    }
    [[ $(tar -tvzf "$staging/$asset") == -* ]] || {
      echo 'Archive must contain a regular binary, not a link.' >&2
      exit 1
    }
    tar -xzf "$staging/$asset" -C "$staging" tctl
    [[ -f $staging/tctl && ! -L $staging/tctl ]] || {
      echo 'Invalid binary archive.' >&2
      exit 1
    }
  fi
fi
chmod 755 "$staging/tctl"
"$staging/tctl" --version
if [[ -f $root/bin/tctl ]] && cmp -s "$staging/tctl" "$root/bin/tctl"; then
  echo 'bin/tctl is current.'
else
  mv -f "$staging/tctl" "$root/bin/tctl"
  echo 'Installed bin/tctl. Run ./bin/tctl, or add this repository/bin to PATH.'
fi
