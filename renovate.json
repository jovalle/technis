{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["docker-compose"],
  "packageRules": [
    {
      "matchManagers": ["docker-compose"],
      "automerge": false
    },
    {
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["docker/services/flaresolverr/compose.yaml"],
      "matchPackageNames": ["ghcr.io/flaresolverr/flaresolverr"],
      "allowedVersions": "/^v3\\.[0-9]+\\.[0-9]+$/",
      "pinDigests": true
    },
    {
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["docker/services/flaresolverr/compose.yaml"],
      "matchPackageNames": ["ghcr.io/flaresolverr/flaresolverr"],
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["docker/services/redis/compose.yaml"],
      "matchPackageNames": ["docker.io/oliver006/redis_exporter"],
      "allowedVersions": "/^v1\\.[0-9]+\\.[0-9]+$/",
      "pinDigests": true
    },
    {
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["docker/services/redis/compose.yaml"],
      "matchPackageNames": ["docker.io/oliver006/redis_exporter"],
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["docker/services/atuin/compose.yaml"],
      "matchPackageNames": ["ghcr.io/atuinsh/atuin"],
      "allowedVersions": "/^18\\.[0-9]+\\.[0-9]+$/",
      "pinDigests": true
    },
    {
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["docker/services/atuin/compose.yaml"],
      "matchPackageNames": ["ghcr.io/atuinsh/atuin"],
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["docker/services/victoriametrics/alert/compose.yaml"],
      "matchPackageNames": ["docker.io/victoriametrics/vmalert"],
      "allowedVersions": "/^v1\\.[0-9]+\\.[0-9]+$/",
      "pinDigests": true
    },
    {
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["docker/services/victoriametrics/alert/compose.yaml"],
      "matchPackageNames": ["docker.io/victoriametrics/vmalert"],
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "automerge": true,
      "platformAutomerge": false
    }
  ]
}
