{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests"],
  "enabledManagers": [
    "npm",
    "pep621",
    "github-actions",
    "docker-compose",
    "gomod"
  ],
  "ignorePaths": ["**/kubernetes/**", "**/charts/**"],
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "matchFileNames": ["pyproject.toml"],
      "groupName": "python pyproject dependencies",
      "labels": ["python", "dependencies"]
    },
    {
      "matchManagers": ["npm"],
      "groupName": "javascript dependencies",
      "labels": ["javascript", "dependencies"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions dependencies",
      "labels": ["github-actions", "dependencies"]
    },
    {
      "matchManagers": ["docker-compose"],
      "groupName": "docker compose images",
      "labels": ["docker", "dependencies"]
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "go dependencies",
      "labels": ["go", "dependencies"]
    },
    {
      "automerge": true,
      "automergeType": "pr",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "dev dependencies",
      "groupSlug": "dev-dependencies-patch",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "schedule": ["before 6am on Monday"]
    }
  ],
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "timezone": "America/New_York",
  "schedule": ["before 6am on Monday"]
}
