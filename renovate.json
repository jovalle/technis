{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": true,
  "enabledManagers": [
    "helmv3"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "docker-compose"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "docker-compose"
      ],
      "matchFileNames": [
        "docker/services/flaresolverr/compose.yaml"
      ],
      "matchPackageNames": [
        "ghcr.io/flaresolverr/flaresolverr"
      ],
      "enabled": true,
      "pinDigests": true,
      "automerge": true
    },
    {
      "matchManagers": [
        "docker-compose"
      ],
      "matchFileNames": [
        "docker/services/flaresolverr/compose.yaml"
      ],
      "matchPackageNames": [
        "ghcr.io/flaresolverr/flaresolverr"
      ],
      "automerge": false
    }
  ],
  "ignorePaths": [
    "**/*"
  ]
}
