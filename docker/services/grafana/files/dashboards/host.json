            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "environment": true,
              "instance": true,
              "site": true,
              "stack": true,
              "host": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "container": "Container",
              "state": "State",
              "health": "Health",
              "name": "Name",
              "image": "Image",
              "job": "Job"
            }
          }
        }
      ]
    },
    {
