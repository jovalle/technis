              "Time": true,
              "__name__": true,
              "environment": true,
              "instance": true,
              "site": true,
              "stack": true,
              "host": true
            },
            "indexByName": {},
            "renameByName": {
              "container": "Container",
              "state": "State",
              "health": "Health",
              "name": "Name",
              "image": "Image",
              "job": "Job"
            }
          }
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(node_uname_info{job=\"node\"}, host)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": ".*",
        "current": {
          "text": "stargate",
          "value": "stargate"
        }
      }
    ]
  },
