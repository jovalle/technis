  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(node_uname_info{job=\"node\"}, host)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": ".*",
        "current": {
          "text": "stargate",
          "value": "stargate"
        }
      },
      {
        "name": "signal",
        "label": "Signal",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(technis:signal{host=~\"$host\"}, signal)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": ".*",
        "current": {
          "text": "cpu_busy_ratio",
          "value": "cpu_busy_ratio"
        }
      }
    ]
  },
