{
  "id": null,
  "uid": "technis-intelligence",
  "title": "Anomalies and telemetry health",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["technis", "observability"],
  "description": "Statistical deviations, not causal inference or Netdata ML. Baselines exclude the latest five minutes, warm up for one hour, and become more representative after 24 hours. No anomaly pages are sent.",
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Largest deviations now",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Absolute standard deviations from the previous baseline. Rank alone does not establish a fault or cause.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, technis:anomaly_score{host=~\"$host\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "environment": true,
              "instance": true,
              "site": true,
              "stack": true,
              "host": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "container": "Container",
              "state": "State",
              "health": "Health",
              "name": "Name",
              "image": "Image",
              "job": "Job"
            }
          }
        }
      ]
    },
