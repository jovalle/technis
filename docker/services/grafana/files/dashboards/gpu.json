  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Intel / AMD inventory",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
