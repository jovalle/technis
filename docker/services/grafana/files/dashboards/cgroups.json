{
  "id": null,
  "uid": "technis-cgroups",
  "title": "Containers and services",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["technis", "observability"],
  "description": "Docker containers and systemd cgroups. Parent cgroups include descendants; do not sum parents and children. Pressure values are the kernel's averages.",
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(technis_cgroup_cpu_seconds_total{host=~\"$host\",job=\"node\",cgroup=~\"$cgroup\",mode=\"usage\"}[$__rate_interval])",
          "legendFormat": "{{cgroup}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
