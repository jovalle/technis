+    --popover-foreground: #f8fafc;
+    --primary: #00d3f2;
+    --primary-foreground: #06202a;
+    --secondary: #102a39;
+    --secondary-foreground: #e6f9fc;
+    --muted: #162131;
+    --muted-foreground: #b5c4d0;
+    --accent: #153043;
+    --accent-foreground: #f8fafc;
+    --border: #263648;
+    --input: #456075;
+    --ring: #00d3f2;
+    --radius: 0;
+    --custom-icon: #00d3f2;
+    --custom-loading-bar: #00d3f2;
+    --divider: #263648;
+}
+
+body {
+    background-image:
+        linear-gradient(to right, rgb(0 211 242 / 0.035) 1px, transparent 1px),
+        linear-gradient(to bottom, rgb(0 211 242 / 0.035) 1px, transparent 1px);
+    background-size: 40px 40px;
+}
+
+.technis-auth-shell {
+    min-height: 100vh;
+}
+
+.technis-auth-main {
+    display: flex;
+    min-height: 100vh;
+    align-items: center;
+    justify-content: center;
+    padding: 2rem 1rem;
+    text-align: center;
+}
+
+.technis-auth-panel {
+    position: relative;
+    border: 1px solid var(--border);
+    background: var(--card);
+    padding-top: 3.5rem;
+    padding-bottom: 2rem;
+    box-shadow: 0 24px 64px rgb(0 0 0 / 0.12);
+}
+
+.technis-auth-controls {
+    position: absolute;
+    top: 0.75rem;
+    right: 0.75rem;
+    display: flex;
+    align-items: center;
+}
+
+.technis-auth-status {
+    margin-top: 1.5rem;
+    padding: 0.9rem 1rem;
+    border: 1px solid var(--primary);
+    background: linear-gradient(90deg, rgb(0 211 242 / 0.08), rgb(0 211 242 / 0.24), rgb(0 211 242 / 0.08));
+    box-shadow: 0 0 22px rgb(0 211 242 / 0.13), inset 0 0 18px rgb(0 211 242 / 0.1);
+    color: var(--foreground);
+    text-align: center;
+}
+
+.technis-auth-status p {
+    margin: 0;
+    font-size: clamp(1.125rem, 4vw, 1.5rem);
+    font-weight: 700;
+    letter-spacing: 0.08em;
+    line-height: 1.2;
+    text-shadow: 0 0 12px rgb(0 211 242 / 0.45);
+    text-transform: uppercase;
+}
+
+.technis-auth-menu [data-slot="dropdown-menu-item"] {
+    min-height: 2.75rem;
+    color: var(--popover-foreground);
+}
+
+.technis-auth-menu [data-slot="dropdown-menu-item"] svg {
+    color: var(--primary);
+}
+
+[data-theme="dark"] .technis-auth-panel,
+[data-theme="grey"] .technis-auth-panel,
+[data-theme="oled"] .technis-auth-panel {
+    box-shadow: 0 24px 64px rgb(0 0 0 / 0.35);
+}
+
+button[data-slot="button"] {
+    text-transform: none;
+}
+
+:is(a, button, input):focus-visible {
+    outline: 2px solid var(--ring);
+    outline-offset: 2px;
+}
+
+@media (max-width: 480px) {
+    .technis-auth-main {
+        align-items: flex-start;
+        padding: 1rem;
+    }
+
+    .technis-auth-panel {
+        padding: 3.25rem 1.5rem 1.5rem;
+    }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .technis-auth-shell *,
+    .technis-auth-shell *::before,
+    .technis-auth-shell *::after {
+        animation-duration: 0.01ms !important;
+        transition-duration: 0.01ms !important;
+    }
+}
