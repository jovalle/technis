diff --git a/web/src/technis.css b/web/src/technis.css
new file mode 100644
index 0000000..3a78717
--- /dev/null
+++ b/web/src/technis.css
@@ -0,0 +1,126 @@
+@font-face {
+    font-family: "Inter";
+    src: url("/static/media/inter-latin.woff2") format("woff2");
+    font-style: normal;
+    font-weight: 100 900;
+    font-display: swap;
+}
+
+:root,
+[data-theme="light"] {
+    --background: #ffffff;
+    --foreground: #101828;
+    --card: #ffffff;
+    --card-foreground: #101828;
+    --popover: #ffffff;
+    --popover-foreground: #101828;
+    --primary: #007595;
+    --primary-foreground: #ffffff;
+    --secondary: #e7f9fc;
+    --secondary-foreground: #123542;
+    --muted: #f4f7f9;
+    --muted-foreground: #475467;
+    --accent: #e7f9fc;
+    --accent-foreground: #123542;
+    --border: #d9e2e8;
+    --input: #a9bac5;
+    --ring: #007595;
+    --radius: 0;
+    --custom-icon: #007595;
+    --custom-loading-bar: #007595;
+    --divider: #d9e2e8;
+}
+
+[data-theme="dark"],
+[data-theme="grey"],
+[data-theme="oled"] {
+    --background: #030712;
+    --foreground: #f8fafc;
+    --card: #0b1220;
+    --card-foreground: #f8fafc;
+    --popover: #0b1220;
+    --popover-foreground: #f8fafc;
+    --primary: #00d3f2;
+    --primary-foreground: #06202a;
+    --secondary: #102a39;
+    --secondary-foreground: #e6f9fc;
+    --muted: #162131;
+    --muted-foreground: #b5c4d0;
+    --accent: #153043;
+    --accent-foreground: #f8fafc;
+    --border: #263648;
+    --input: #456075;
+    --ring: #00d3f2;
+    --radius: 0;
+    --custom-icon: #00d3f2;
+    --custom-loading-bar: #00d3f2;
+    --divider: #263648;
+}
+
+body {
+    background-image:
+        linear-gradient(to right, rgb(0 211 242 / 0.035) 1px, transparent 1px),
+        linear-gradient(to bottom, rgb(0 211 242 / 0.035) 1px, transparent 1px);
+    background-size: 40px 40px;
+}
+
+.technis-auth-shell {
+    min-height: 100vh;
+}
+
+.technis-auth-header {
+    border-bottom: 1px solid var(--border);
+    background: var(--card);
+}
+
+.technis-auth-main {
+    display: flex;
+    min-height: calc(100vh - 4rem);
+    align-items: center;
+    justify-content: center;
+    padding: 2rem 1rem;
+    text-align: center;
+}
+
+.technis-auth-panel {
+    border: 1px solid var(--border);
+    background: var(--card);
+    padding-top: 2rem;
+    padding-bottom: 2rem;
+    box-shadow: 0 24px 64px rgb(0 0 0 / 0.12);
+}
+
+[data-theme="dark"] .technis-auth-panel,
+[data-theme="grey"] .technis-auth-panel,
+[data-theme="oled"] .technis-auth-panel {
+    box-shadow: 0 24px 64px rgb(0 0 0 / 0.35);
+}
+
+button[data-slot="button"] {
+    text-transform: none;
+}
+
+:is(a, button, input):focus-visible {
+    outline: 2px solid var(--ring);
+    outline-offset: 2px;
+}
+
+@media (max-width: 480px) {
+    .technis-auth-main {
+        align-items: flex-start;
+        padding: 1rem;
+    }
+
+    .technis-auth-panel {
+        padding: 1.5rem;
+    }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .technis-auth-shell *,
+    .technis-auth-shell *::before,
+    .technis-auth-shell *::after {
+        animation-duration: 0.01ms !important;
+        transition-duration: 0.01ms !important;
+    }
+}
