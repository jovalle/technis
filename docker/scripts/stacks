#!/usr/bin/env bash
# Docker Compose across the Technis stacks, plus workstation setup and checks; run through just.
set -Eeuo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
stacks_dir=$root/docker/stacks
ssh_snippet=$root/ansible/ssh_config

# Output follows jsh: cyan activity, dim notes, green ✓, yellow !, red ✗.
# Decoration goes to stderr; tables and command output stay on stdout.
tty1=0 tty2=0
[[ -t 1 ]] && tty1=1
[[ -t 2 ]] && tty2=1
color_on() {
  [[ ${JSH_PLAIN_OUTPUT:-0} != 1 && ${TERM:-} != dumb && -z ${NO_COLOR+x} ]] || return 1
  case ${JSH_COLOR:-auto} in
    always) return 0 ;;
    never) return 1 ;;
    *) [[ ($1 == 1 && $tty1 == 1) || ($1 == 2 && $tty2 == 1) ]] ;;
  esac
}
sgr() { if color_on "$1"; then printf '\033[%sm' "$2"; fi; }
E_B=$(sgr 2 1) E_D=$(sgr 2 '2;37') E_C=$(sgr 2 36) E_G=$(sgr 2 32) E_Y=$(sgr 2 33) E_R=$(sgr 2 31) E_X=$(sgr 2 0)
O_B=$(sgr 1 1) O_D=$(sgr 1 '2;37') O_C=$(sgr 1 36) O_G=$(sgr 1 32) O_Y=$(sgr 1 33) O_R=$(sgr 1 31) O_X=$(sgr 1 0)

say() { printf '%s\n' "$*" >&2; }
info() { say "${E_C}$*${E_X}"; }
muted() { say "${E_D}$*${E_X}"; }
blank() { printf '\n' >&2; }
die() {
  say "${E_R}✗ $*${E_X}"
  exit 1
}
# row STATE SUBJECT [DETAIL]; STATE is info, ok, warn, fail, or skip.
row() {
  local mark color
  case $1 in
    info) mark='→' color=$E_C ;;
    ok) mark='✓' color=$E_G ;;
    warn) mark='!' color=$E_Y ;;
    fail) mark='✗' color=$E_R ;;
    *) mark='–' color=$E_D ;;
  esac
  say "${color}${mark}${E_X} ${E_B}$2${E_X}${3:+ ${E_D}$3${E_X}}"
}

has() { command -v "$1" >/dev/null 2>&1; }
in_list() {
  local needle=$1 x
  shift
  for x in "$@"; do [[ $x == "$needle" ]] && return 0; done
  return 1
}
plural() { if (($1 == 1)); then printf '%s %s' "$1" "$2"; else printf '%s %ss' "$1" "$2"; fi; }

ssh_config_first() {
  [[ -f $HOME/.ssh/config ]] &&
    [[ $(awk '!/^[[:space:]]*(#|$)/ {sub(/^[[:space:]]*/, ""); sub(/[[:space:]]*$/, ""); print; exit}' "$HOME/.ssh/config") == "Include \"$ssh_snippet\"" ]]
}

now_ms() {
  if [[ -n ${EPOCHREALTIME:-} ]]; then
    local t=${EPOCHREALTIME/[.,]/}
    printf '%s\n' $((t / 1000))
  elif has perl; then
    perl -MTime::HiRes=time -e 'printf "%d\n", time * 1000'
  else
    printf '%s\n' $(($(date +%s) * 1000))
  fi
}
took() {
  local ms=$(($(now_ms) - $1))
  if ((ms < 1000)); then printf '[%dms]' "$ms"; else printf '[%d.%02ds]' $((ms / 1000)) $((ms % 1000 / 10)); fi
}

confirm() {
  [[ ${assume_yes:-0} == 1 ]] && return 0
  [[ -t 0 ]] || die "no terminal to confirm, pass --yes: $1"
  local answer sep=' '
  [[ $1 == *$'\n' ]] && sep=
  printf '%s' "${E_Y}$1${sep}Type yes to continue:${E_X} " >&2
  read -r answer
  [[ $answer == yes ]]
}

usage() {
  local s list=
  for s in $(stacks); do list+="${list:+, }$s"; done
  cat <<EOF
${O_B}just${O_X} ${O_D}Docker Compose across the Technis stacks ($list)${O_X}

${O_B}Commands:${O_X}
  ${O_C}just deploy${O_X} ${O_D}[target]${O_X}          start or update services, removing orphaned containers
  ${O_C}just check${O_X} ${O_D}[target]${O_X}           preflight compose models, then show container status
  ${O_C}just logs${O_X} ${O_D}<target> [flags]${O_X}    show or follow logs
  ${O_C}just update${O_X} ${O_D}<target>${O_X}          pull images and recreate services
  ${O_C}just compose${O_X} ${O_D}<stack> <args...>${O_X} pass arguments to Docker Compose
  ${O_C}just sync${O_X} ${O_D}<stack> [-n] [service...]${O_X}  copy service files to the host (default: all)
  ${O_C}just check workstation${O_X}       check tools, SSH, contexts, and engines
  ${O_C}just prepare workstation${O_X}     install tools and configure the workstation
  ${O_C}just prepare contexts${O_X}        create the Docker contexts

${O_B}Options:${O_X}
  ${O_C}-s, --stack${O_X} ${O_D}<name>${O_X}   filter stacks, repeatable or comma-separated
  ${O_C}-y, --yes${O_X}            skip the confirmation for other changes on several stacks

${O_B}Environment:${O_X}
  ${O_C}STACKS_PROGRESS=compose${O_X}  use Compose's own progress view for detached runs;
                           by default show resource progress and final results

${O_B}Targeting:${O_X}
  Use a stack name, a service name, or stack/service. Service names are found
  across all stacks; -s filters the stacks. Deploy and check default
  to all stacks. Other changes across stacks ask first.
  Preflight prompts for missing values on a terminal; Esc skips, Ctrl-C stops.
  Values are hidden and used only for the current run; skipped values block changes.

${O_B}Examples:${O_X}
  just check
  just logs alloy -f
  just deploy immich -s nexus
  just update nexus/immich
  just compose nexus config --services
EOF
}

stacks() {
  local f
  for f in "$stacks_dir"/*; do
    [[ -d $f ]] && basename "$f"
  done
}

secretless_verbs=(ps ls images top port version volumes logs stats events)

# secretless COMPOSE_ARGS...; read-only calls get placeholders instead of secret values.
secretless() {
  [[ ${1:-} == --progress ]] && shift 2
  local verb=${1:-} a
  in_list "$verb" "${secretless_verbs[@]}" && return 0
  [[ $verb == config ]] || return 1
  for a in "$@"; do [[ $a == --hash* ]] && return 1; done
  return 0
}

resolve() {
  if [[ $1 == secret ]]; then
    python3 "$root/tools/vault.py" inject
  else
    # *_IP keys must parse as addresses for Compose validation.
    sed -E -e "s/^([A-Za-z0-9_]*_IP=)'?\{\{ *vault:\/\/[^}]*\}\}'?/\1127.0.0.1/" \
      -e 's/\{\{ *vault:\/\/[^}]*\}\}/placeholder/g'
  fi
}

# stack_env STACK MODE OUT; one resolve per stack, then one file per app: common, stack, app, stack override.
stack_env() (
  umask 077
  local stack=$1 mode=$2 out=$3 dir=$stacks_dir/$1 name f apps
  apps=$(sed -nE 's/.*\$\{TECHNIS_ENV[^}]*\}\/([^ ]+)\.env.*/\1/p' "$dir/compose.yaml" | grep -vxE 'common|stack' | sort -u)
  mkdir "$out" "$out/.parts"
  : >"$out/project.env"
  {
    for name in common stack $apps; do
      printf '#env:%s\n' "$name"
      case $name in
        common) set -- "$root/docker/.env" ;;
        stack) set -- "$dir/.env" ;;
        *) set -- "$root/docker/services/${name//.//}/.env" "$dir/services/${name//.//}/.env" ;;
      esac
      for f; do [[ ! -f $f ]] || { cat "$f" && echo; }; done
    done
  } | resolve "$mode" |
    awk -v out="$out/.parts" '/^#env:/ { if (f) close(f); f = out "/" substr($0, 6) ".env"; printf "" >f; next } { print >f }' ||
    { rm -rf "$out" && exit 1; }
  # Within one dotenv file the last assignment wins, so later layers override earlier ones.
  for name in $apps; do cat "$out/.parts/common.env" "$out/.parts/stack.env" "$out/.parts/$name.env" >"$out/$name.env"; done
  rm -rf "$out/.parts"
  if [[ -f $env_root/$stack.inputs ]]; then
    for f in "$out"/*.env; do cat "$env_root/$stack.inputs" >>"$f"; done
  fi
)

# Isolate every call from direnv state; the project .env stays unread so raw references never override.
compose() {
  local stack=$1
  shift
  local dir=$stacks_dir/$stack mode=secret envs
  if [[ ${compose_mode:-} != secret ]] && secretless "$@"; then mode=plain; fi
  envs=$env_root/$stack.$mode
  [[ -d $envs ]] || stack_env "$stack" "$mode" "$envs" || return
  env -u DOCKER_HOST -u DOCKER_CONTEXT -u COMPOSE_FILE -u COMPOSE_PROJECT_NAME -u COMPOSE_PROFILES \
    COMPOSE_ENV_FILES="$envs/project.env" TECHNIS_ENV="$envs" \
    docker --context "$stack" compose --project-directory "$dir" -f "$dir/compose.yaml" "$@"
}

# Prompt values stay in private temporary files and are never echoed or saved to the repository.
prompt_value() {
  local key=$1 char value=''
  [[ -t 0 ]] || return 1
  printf '%s' "$key (hidden; Enter accepts, Esc skips): " >&2
  while IFS= read -rsn1 char; do
    case $char in
      $'\e')
        printf '\n' >&2
        return 1
        ;;
      '')
        printf '\n' >&2
        [[ -n $value ]] || return 1
        REPLY=$value
        return 0
        ;;
      $'\177' | $'\b') value=${value%?} ;;
      *) value+=$char ;;
    esac
  done
  printf '\n' >&2
  return 1
}

# Compose validates the complete model locally; missing values can be supplied for this run.
preflight() {
  local s=$1 err=$env_root/$1.preflight.err key value f rc skipped=0 seen=' '
  [[ -f $stacks_dir/$s/compose.yaml ]] || {
    row fail "$s" 'compose.yaml missing'
    return 1
  }
  while :; do
    if compose "$s" config --quiet 2>"$err"; then rc=0; else rc=$?; fi
    key=$(sed 's/\\"/"/g' "$err" | sed -nE -e 's/.*required variable ([A-Za-z_][A-Za-z0-9_]*) is missing a value.*/\1/p' \
      -e 's/.*The "([A-Za-z_][A-Za-z0-9_]*)" variable is not set.*/\1/p' | head -1)
    if [[ -z $key ]]; then
      if ((rc)); then
        cat "$err" >&2
        row fail "$s" 'preflight failed'
        return 1
      fi
      break
    fi
    if [[ $seen == *" $key "* ]]; then
      cat "$err" >&2
      row fail "$s" 'preflight could not apply the supplied value'
      return 1
    fi
    seen+="$key "
    if prompt_value "$s: $key"; then value=$REPLY; else
      row warn "$s" "$key skipped"
      skipped=1
      case $key in *_ROOT | *_DIR) value=/tmp/stacks-placeholder ;; *) value=placeholder ;; esac
    fi
    # Single-quoted Compose dotenv values do not interpolate dollar signs.
    value=${value//\\/\\\\}
    value=${value//\'/\\\'}
    printf "%s='%s'\n" "$key" "$value" >>"$env_root/$s.inputs"
    for f in "$env_root/$s.plain"/*.env; do printf "%s='%s'\n" "$key" "$value" >>"$f"; done
  done
  ((skipped == 0)) || {
    row fail "$s" 'preflight has skipped values'
    return 1
  }
  if [[ ${2:-} == secret ]]; then
    if ! compose_mode=secret compose "$s" config --quiet 2>"$err"; then
      cat "$err" >&2
      row fail "$s" 'secret resolution or resolved compose validation failed'
      return 1
    fi
  fi
}

endpoint() { docker context inspect -f '{{.Endpoints.docker.Host}}' "$1" 2>/dev/null; }

# Echo the command Bun-style: dim prompt, bold program, highlighted verb, flags, and services.
show_cmd() {
  local out="${E_D}\$${E_X} ${E_B}compose${E_X}" a first=1 q
  for a in "$@"; do
    q=$a
    [[ $a =~ ^[A-Za-z0-9_./:=@%+,-]+$ ]] || q=$(printf '%q' "$a")
    if ((first)); then
      out+=" ${E_B}${E_C}$q${E_X}"
      first=0
    elif [[ $a == -* ]]; then
      out+=" ${E_D}$q${E_X}"
    elif in_list "$a" ${svc_tokens[@]+"${svc_tokens[@]}"}; then
      out+=" ${E_G}$q${E_X}"
    else
      out+=" $q"
    fi
  done
  say "$out"
}

# ensure_ctx STACK [quiet]; quiet reports only a newly created context.
ensure_ctx() {
  local s=$1 want=ssh://$1 have
  have=$(endpoint "$s" || true)
  if [[ $have == "$want" ]]; then
    [[ ${2:-} == quiet ]] || row ok "$s" "$want"
  elif [[ -z $have ]]; then
    docker context create "$s" --description "Technis $s stack" --docker "host=$want" >/dev/null 2>&1
    row ok "$s" "$want (created)"
  else
    die "context $s points at $have, expected $want; fix it with: docker context update $s --docker host=$want"
  fi
}

cmd_ctx() {
  local s
  for s in $(stacks); do ensure_ctx "$s"; done
}

cmd_doctor() {
  local fails=0 t s v start
  start=$(now_ms)
  info "Tools"
  for t in bash docker ssh git jq direnv rsync nc python3; do
    if has "$t"; then row ok "$t"; else
      row fail "$t" "not installed"
      fails=$((fails + 1))
    fi
  done
  for t in mise pre-commit; do
    if has "$t"; then row ok "$t"; else row warn "$t" "not installed"; fi
  done
  if has docker; then
    if v=$(docker compose version --short 2>/dev/null); then row ok "docker compose" "$v"; else
      row fail "docker compose" "plugin missing"
      fails=$((fails + 1))
    fi
  fi
  if has rsync && ! rsync --version 2>/dev/null | head -1 | grep -q 'version 3\.'; then
    row warn rsync "not 3.x; just sync needs GNU rsync"
  fi

  blank
  info "Workstation"
  if ssh_config_first; then row ok "ssh config" "includes ansible/ssh_config first"; else
    row fail "ssh config" "run: just run workstation --tags ssh"
    fails=$((fails + 1))
  fi
  if [[ -f $HOME/.ssh/technis ]]; then row ok "ssh key" "present at ~/.ssh/technis"; else
    row warn "ssh key" "missing at ~/.ssh/technis; copy it from a trusted workstation"
  fi

  for s in $(stacks); do
    blank
    info "$s"
    if [[ $(endpoint "$s" || true) == "ssh://$s" ]]; then row ok context "ssh://$s"; else
      row fail context "missing or wrong (run: just prepare contexts)"
      fails=$((fails + 1))
      continue
    fi
    if ssh -o BatchMode=yes -o ConnectTimeout=5 "$s" true 2>/dev/null; then
      row ok ssh "$(ssh -G "$s" | awk '/^hostname /{print $2}')"
    else
      row fail ssh "unreachable (key, host key, or network)"
      fails=$((fails + 1))
      continue
    fi
    if v=$(docker --context "$s" version --format '{{.Server.Version}}' 2>/dev/null); then row ok engine "Docker $v"; else
      row fail engine "unreachable"
      fails=$((fails + 1))
    fi
    if compose "$s" config --quiet 2>/dev/null; then row ok "compose model" "valid"; else
      row fail "compose model" "invalid (run: just check $s)"
      fails=$((fails + 1))
    fi
  done
  blank
  ((fails == 0)) || die "doctor: $(plural "$fails" check) failed $(took "$start")"
  row ok doctor "all checks passed $(took "$start")"
}

bootstrap_tools() {
  local pairs="ansible-playbook:ansible direnv:direnv docker:docker git:git jq:jq mise:mise pre-commit:pre-commit nc:netcat" p need=()
  info "Tools"
  for p in $pairs; do has "${p%%:*}" || need+=("${p#*:}"); done
  rsync --version 2>/dev/null | head -1 | grep -q 'version 3\.' || need+=(rsync)
  if ((${#need[@]})); then
    has brew || die "Homebrew is required to install: ${need[*]}. Install it from https://brew.sh, then rerun just prepare workstation."
    if confirm "Install with Homebrew: ${need[*]}."; then brew install "${need[@]}"; else row skip "tools" "skipped: ${need[*]}"; fi
  else
    row ok tools "all present"
  fi
  if ! docker compose version >/dev/null 2>&1; then
    has brew || die "docker compose plugin missing and Homebrew unavailable"
    confirm "Install the docker compose plugin with Homebrew." || return 0
    brew install docker-compose
    local cfg=$HOME/.docker/config.json dir
    dir=$(brew --prefix)/lib/docker/cli-plugins
    mkdir -p "$HOME/.docker"
    [[ -f $cfg ]] || echo '{}' >"$cfg"
    jq --arg d "$dir" '.cliPluginsExtraDirs = ((.cliPluginsExtraDirs // []) + [$d] | unique)' "$cfg" >"$cfg.tmp" && mv -f "$cfg.tmp" "$cfg"
    row ok "docker compose" "plugin installed"
  fi
}

bootstrap_ssh() {
  if confirm "Manage the Technis SSH block in ~/.ssh/config with Ansible (backups are kept)."; then
    (cd "$root" && ansible-playbook ansible/playbooks/workstation.yaml --tags ssh)
  else
    row skip "ssh config" "skipped"
  fi
  [[ -f $HOME/.ssh/technis ]] || row warn "ssh key" "missing at ~/.ssh/technis; copy it from a trusted workstation"
}

bootstrap_shell() {
  local shell_name rc
  shell_name=$(basename "${SHELL:-bash}")
  case $shell_name in
    zsh) rc=$HOME/.zshrc ;;
    bash) rc=$HOME/.bashrc ;;
    *)
      row warn shell "unknown shell $shell_name; add the direnv and mise hooks yourself"
      return 0
      ;;
  esac
  grep -qs 'direnv hook' "$rc" || row warn shell "add to ${rc/#$HOME/~}: eval \"\$(direnv hook $shell_name)\""
  grep -qs 'mise activate' "$rc" || row warn shell "add to ${rc/#$HOME/~}: eval \"\$(mise activate $shell_name)\""
}

cmd_bootstrap() {
  local start s sub
  start=$(now_ms)
  [[ $(uname -s) == Darwin || $(uname -s) == Linux ]] || die "unsupported OS: $(uname -s)"
  bootstrap_tools
  if has mise && confirm "Trust and install the pinned tools in .mise.toml."; then
    mise trust "$root/.mise.toml" && (cd "$root" && mise install)
    row ok mise "tools installed"
  fi
  blank
  info "SSH and Docker contexts"
  bootstrap_ssh
  cmd_ctx
  blank
  info "Repository"
  if has direnv && confirm "Allow direnv for the repo and stack directories."; then
    direnv allow "$root"
    for s in $(stacks); do direnv allow "$stacks_dir/$s"; done
    row ok direnv "allowed"
  fi
  if [[ -d $root/.git ]]; then
    # Only uninitialized submodules; updating checked-out ones would discard local branch state.
    for sub in $(git -C "$root" submodule status | awk '/^-/{print $2}'); do
      git -C "$root" submodule update --init -- "$sub"
      row ok submodule "$sub initialized"
    done
    has pre-commit && (cd "$root" && pre-commit install >/dev/null) && row ok pre-commit "hooks installed"
  else
    row warn repository "no .git here (Syncthing copy?); clone the repo for submodules and hooks"
  fi
  bootstrap_shell
  blank
  row ok bootstrap "done $(took "$start")"
  blank
  cmd_doctor
}

cmd_sync() {
  ((${#targets[@]} == 1)) || die "sync needs exactly one stack"
  local script=$root/docker/scripts/sync dry=() service services=()
  [[ -x $script ]] || die "missing $script"
  if [[ ${1:-} == -n ]]; then
    dry=(-n)
    shift
  fi
  if ((! $#)); then
    while IFS= read -r service; do services+=("$service"); done < <(
      sed -nE 's#.*\.\./\.\./services/(.+)/compose\.yaml.*#\1#p' "$stacks_dir/${targets[0]}/compose.yaml" | sort -u
    )
    set -- "${services[@]}"
  fi
  exec "$script" ${dry[@]+"${dry[@]}"} "${targets[0]}" "$@"
}

readonly_verbs=(ps ls images top port version volumes)
single_verbs=(exec run cp attach events watch)
one_stack_verbs=(down rm)
config_ok_flags=(--quiet -q --services --hash --images --volumes --profiles --networks)

# Map service names in the arguments to the stacks that define them.
narrow_by_service() {
  local verb=$1
  shift
  local tokens=() a s svc matched=()
  for a in "$@"; do
    [[ $a == -* ]] && continue
    [[ $verb == cp ]] && a=${a%%:*}
    tokens+=("$a")
  done
  ((${#tokens[@]})) || return 0
  for s in "${targets[@]}"; do
    local hit=0
    for svc in $(compose "$s" config --services 2>/dev/null); do
      if in_list "$svc" "${tokens[@]}"; then
        hit=1
        in_list "$svc" ${svc_tokens[@]+"${svc_tokens[@]}"} || svc_tokens+=("$svc")
      fi
    done
    ((hit)) && matched+=("$s")
  done
  ((${#matched[@]})) && targets=("${matched[@]}")
  return 0
}

# Resolve an explicit stack, service, or stack/service before any changes.
control_target() {
  local selector=$1 s services matched=() stack='' service=''
  [[ -n $selector ]] || return 0
  if [[ $selector == */* ]]; then
    stack=${selector%%/*}
    service=${selector#*/}
    [[ -n $stack && -n $service && $service != */* ]] || die "invalid target '$selector'"
    in_list "$stack" "${all[@]}" || die "unknown stack '$stack'"
    in_list "$stack" "${targets[@]}" || die "target '$selector' excluded by -s"
    targets=("$stack")
  elif in_list "$selector" "${all[@]}"; then
    in_list "$selector" "${targets[@]}" || die "stack '$selector' excluded by -s"
    targets=("$selector")
    return 0
  else
    service=$selector
  fi
  for s in "${targets[@]}"; do
    if ! services=$(compose "$s" config --services 2>"$env_root/$s.discovery.err"); then
      preflight "$s" || die "cannot discover services on $s"
      services=$(compose "$s" config --services) || die "cannot discover services on $s"
    fi
    if grep -qxF -- "$service" <<<"$services"; then matched+=("$s"); fi
  done
  ((${#matched[@]})) || die "service '$service' not found in selected stacks"
  targets=("${matched[@]}")
  svc_tokens=("$service")
}

# Follow all selected stacks concurrently, with each line labelled by its stack.
follow_logs() {
  local s pid rc=0 pids=()
  show_cmd logs "$@"
  for s in "${targets[@]}"; do
    ensure_ctx "$s" quiet
    (compose "$s" logs "$@" | while IFS= read -r line || [[ -n $line ]]; do printf '[%s] %s\n' "$s" "$line"; done) &
    pids+=("$!")
  done
  trap 'kill "${pids[@]}" 2>/dev/null || true; exit 130' INT TERM
  for pid in "${pids[@]}"; do wait "$pid" || rc=1; done
  return "$rc"
}

status_color() {
  case $1/$2 in
    running/unhealthy | exited/* | dead/*) printf '%s' "$O_R" ;;
    running/starting | restarting/* | paused/* | created/* | removing/*) printf '%s' "$O_Y" ;;
    running/*) printf '%s' "$O_G" ;;
    *) printf '%s' "$O_D" ;;
  esac
}

# One table for every targeted stack; fetched in parallel, colored by state and health.
ps_table() {
  local start tmp s rc failed=() rows=() line
  start=$(now_ms)
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/stacks.XXXXXX")
  for s in "${targets[@]}"; do
    (
      if compose "$s" ps --format json "$@" >"$tmp/$s.json" 2>"$tmp/$s.err"; then echo 0; else echo $?; fi >"$tmp/$s.rc"
    ) &
  done
  wait
  for s in "${targets[@]}"; do
    rc=$(cat "$tmp/$s.rc")
    if [[ $rc != 0 ]]; then
      failed+=("$s")
      row fail "$s" "$(tr '\n' ' ' <"$tmp/$s.err")"
      continue
    fi
    while IFS= read -r line; do rows+=("$line"); done < <(
      # "-" keeps empty health from collapsing adjacent tab-separated fields on read.
      jq -r --arg s "$s" '(if type == "array" then .[] else . end)
        | [$s, .Service, .State, ((.Health // "") | if . == "" then "-" else . end), .Status,
           (.Image | sub("@sha256:[0-9a-f]+$"; ""))] | @tsv' "$tmp/$s.json"
    )
  done
  rm -rf "$tmp"

  local w1=5 w2=7 w3=6 stack svc state health status image n=0 bad=() warn_n=0
  for line in ${rows[@]+"${rows[@]}"}; do
    IFS=$'\t' read -r stack svc state health status image <<<"$line"
    ((${#stack} > w1)) && w1=${#stack}
    ((${#svc} > w2)) && w2=${#svc}
    ((${#status} > w3)) && w3=${#status}
  done
  if ((${#rows[@]})); then
    printf '%s%-*s  %-*s  %-*s  %s%s\n' "$O_D" "$w1" STACK "$w2" SERVICE "$w3" STATUS IMAGE "$O_X"
    while IFS= read -r line; do
      IFS=$'\t' read -r stack svc state health status image <<<"$line"
      printf '%s%-*s%s  %s%-*s%s  %s%-*s%s  %s%s%s\n' \
        "$O_C" "$w1" "$stack" "$O_X" "$O_B" "$w2" "$svc" "$O_X" \
        "$(status_color "$state" "$health")" "$w3" "$status" "$O_X" "$O_D" "$image" "$O_X"
      n=$((n + 1))
      case $state/$health in
        running/unhealthy | exited/* | dead/*) bad+=("$stack/$svc") ;;
        running/starting | restarting/*) warn_n=$((warn_n + 1)) ;;
      esac
    done < <(printf '%s\n' "${rows[@]}" | sort -t $'\t' -k1,1 -k2,2)
  fi

  local ok_n=$((${#targets[@]} - ${#failed[@]}))
  blank
  ((${#bad[@]} == 0)) || row warn "$(plural ${#bad[@]} container) not healthy" "${bad[*]}"
  ((warn_n == 0)) || row warn "$(plural "$warn_n" container) starting"
  ((${#failed[@]} == 0)) || die "$(plural ${#failed[@]} stack) failed: ${failed[*]} $(took "$start")"
  row ok "$(plural "$n" container) on $(plural "$ok_n" stack)" "$(took "$start")"
}

# Attached up streams logs on the same terminal, so only detached or waiting runs are filtered.
compose_up() {
  local s=$1 a filter=0 rc render_rc
  shift
  for a in "$@"; do [[ $a == -d || $a == --detach || $a == --wait ]] && filter=1; done
  if ((filter)) && [[ ${STACKS_PROGRESS:-} != compose ]] && has python3; then
    local results=() capture line
    capture=$(mktemp "${env_root:-${TMPDIR:-/tmp}}/stacks-progress.XXXXXX") || {
      compose "$s" up "$@"
      return
    }
    if {
      compose "$s" --progress json up "$@" 2>&1 1>&3 3>&- |
        (
          trap '' PIPE
          while IFS= read -r line || [[ -n $line ]]; do
            printf '%s\n' "$line" >&4 || :
            printf '%s\n' "$line" 2>/dev/null || :
          done
        ) 4>"$capture" | python3 "$root/docker/scripts/compose_progress.py" "$s"
      results=("${PIPESTATUS[@]}")
    } 3>&1; then :; fi
    rc=${results[0]:-1} render_rc=${results[2]:-1}
    if ((render_rc != 0)); then
      row warn 'progress display failed' "exit $render_rc; raw Compose progress follows"
      cat "$capture" >&2
    fi
    rm -f "$capture"
    return "$rc"
  else
    compose "$s" up "$@"
  fi
}

# up alone reuses a cached image, so upgrade pulls first.
stack_run() {
  local s=$1 verb=$2
  shift 2
  if [[ ${raw_compose:-0} == 1 ]]; then
    compose "$s" "$verb" "$@"
  elif [[ $verb == upgrade ]]; then
    compose "$s" pull "$@" && compose_up "$s" -d "$@"
  elif [[ $verb == up ]]; then
    compose_up "$s" "$@"
  else
    compose "$s" "$verb" "$@"
  fi
}

run_compose() {
  local verb=$1 kind=change a
  shift
  if [[ $verb == upgrade ]]; then
    for a in "$@"; do [[ $a != -* ]] || die "upgrade takes service names only, got $a"; done
  fi
  if in_list "$verb" "${readonly_verbs[@]}"; then kind=safe; fi
  in_list "$verb" "${single_verbs[@]}" && kind=single
  in_list "$verb" "${one_stack_verbs[@]}" && kind=one
  case $verb in
    logs) kind=safe && for a in "$@"; do [[ $a == -f || $a == --follow ]] && kind=single; done ;;
    stats) kind=single && for a in "$@"; do [[ $a == --no-stream ]] && kind=safe; done ;;
    config)
      kind=blocked
      for a in "$@"; do in_list "$a" "${config_ok_flags[@]}" && kind=safe; done
      [[ $kind == safe ]] || die "config prints interpolated secrets; use --quiet, --services, --hash, or --images"
      ;;
  esac

  [[ $explicit == 1 ]] || narrow_by_service "$verb" "$@"
  local n=${#targets[@]} s
  for s in "${targets[@]}"; do ensure_ctx "$s" quiet; done
  case $kind in
    single) ((n == 1)) || die "$verb needs exactly one stack; matched: ${targets[*]} (use -s)" ;;
    one) ((n == 1)) || die "$verb is limited to one stack; matched: ${targets[*]} (use -s)" ;;
    change)
      if ((n > 1)); then
        local msg="Run compose $verb${*:+ $*} on $n stacks:"$'\n'
        for s in "${targets[@]}"; do msg+="  $s"$'\n'; done
        confirm "$msg" || die "cancelled"
      fi
      ;;
  esac

  if [[ $verb == ps && ${raw_compose:-0} != 1 ]]; then
    local plain=0
    for a in "$@"; do [[ $a == -q || $a == --quiet || $a == --format || $a == --format=* ]] && plain=1; done
    ((plain)) || {
      ps_table "$@"
      return
    }
  fi

  if [[ $verb == upgrade ]]; then
    show_cmd pull "$@"
    show_cmd up -d "$@"
  else
    show_cmd "$verb" "$@"
  fi
  if [[ $kind == single ]]; then
    row info "${targets[0]}" "$(endpoint "${targets[0]}")"
    compose "${targets[0]}" "$verb" "$@"
    return
  fi

  local start stack_start failed=() rc first=1
  start=$(now_ms)
  for s in "${targets[@]}"; do
    ((first)) || blank
    first=0
    row info "$s" "$(endpoint "$s")"
    stack_start=$(now_ms)
    if stack_run "$s" "$verb" "$@"; then :; else
      rc=$?
      row fail "$s" "exit $rc $(took "$stack_start")"
      failed+=("$s")
    fi
  done
  ((n == 1)) || blank
  ((${#failed[@]} == 0)) || die "${#failed[@]} of $(plural "$n" stack) failed: ${failed[*]} $(took "$start")"
  if ((n == 1)); then row ok "${targets[0]}" "$(took "$start")"; else row ok "$(plural "$n" stack)" "$(took "$start")"; fi
}

main() {
  targets=()
  svc_tokens=()
  explicit=0
  assume_yes=0
  local s all=()
  for s in $(stacks); do all+=("$s"); done
  while (($#)); do
    case $1 in
      -s | --stack)
        [[ -n ${2:-} ]] || die "$1 needs a stack name"
        for s in ${2//,/ }; do
          in_list "$s" "${all[@]}" || die "unknown stack '$s' (known: ${all[*]})"
          in_list "$s" ${targets[@]+"${targets[@]}"} || targets+=("$s")
        done
        explicit=1
        shift 2
        ;;
      -y | --yes)
        assume_yes=1
        shift
        ;;
      -h | --help | help)
        usage
        return 0
        ;;
      --)
        shift
        break
        ;;
      -*) die "unknown option $1 (options go before the command)" ;;
      *) break ;;
    esac
  done
  (($#)) || {
    usage >&2
    exit 2
  }
  ((${#targets[@]})) || targets=("${all[@]}")
  has docker || [[ $1 == bootstrap ]] || die "docker CLI not found; run: just prepare workstation"

  local verb=$1 args=() a passthru=0 selector='' follow=0
  shift
  if in_list "$verb" deploy check status logs upgrade; then
    while (($#)); do
      case $1 in
        -s | --stack)
          [[ -n ${2:-} ]] || die "$1 needs a stack name"
          if [[ $explicit == 0 ]]; then
            targets=()
            explicit=1
          fi
          for s in ${2//,/ }; do
            in_list "$s" "${all[@]}" || die "unknown stack '$s' (known: ${all[*]})"
            in_list "$s" ${targets[@]+"${targets[@]}"} || targets+=("$s")
          done
          shift 2
          ;;
        -y | --yes)
          assume_yes=1
          shift
          ;;
        -f | --follow)
          [[ $verb == logs ]] || die "unknown option $1"
          follow=1
          args+=("$1")
          shift
          ;;
        -*)
          [[ $verb == logs ]] || die "unknown option $1"
          args+=("$1")
          case $1 in --tail | -n | --since | --until)
            [[ -n ${2:-} ]] || die "$1 needs a value"
            args+=("$2")
            shift
            ;;
          esac
          shift
          ;;
        *)
          [[ -z $selector ]] || die "$verb takes one target"
          selector=$1
          shift
          ;;
      esac
    done
    [[ $verb != logs && $verb != upgrade || -n $selector ]] || die "$verb needs a stack or service"
    env_root=$(mktemp -d "${TMPDIR:-/tmp}/stacks-env.XXXXXX")
    trap 'rm -rf "$env_root"' EXIT
    trap 'exit 130' INT TERM
    control_target "$selector"
    explicit=1
    if in_list "$verb" deploy check upgrade; then
      for s in "${targets[@]}"; do preflight "$s" secret || die "preflight failed for $s"; done
    fi
    case $verb in
      deploy) assume_yes=1 run_compose up -d --remove-orphans ${svc_tokens[@]+"${svc_tokens[@]}"} ;;
      check | status) run_compose ps ${svc_tokens[@]+"${svc_tokens[@]}"} ;;
      logs)
        if ((follow && ${#targets[@]} > 1)); then
          follow_logs "${args[@]}" ${svc_tokens[@]+"${svc_tokens[@]}"}
        else run_compose logs "${args[@]}" ${svc_tokens[@]+"${svc_tokens[@]}"}; fi
        ;;
      upgrade) run_compose upgrade ${svc_tokens[@]+"${svc_tokens[@]}"} ;;
    esac
    return
  fi
  if [[ $verb == compose ]]; then
    (($#)) || die "compose needs arguments"
    explicit=1
    passthru=1
    raw_compose=1
    verb=$1
    shift
  fi
  # Compose's own up/create -y auto-accepts volume recreation, so this script keeps -y for itself.
  if ((passthru)) || in_list "$verb" "${single_verbs[@]}"; then args=("$@"); else
    for a in "$@"; do
      if ((passthru == 0)) && [[ $a == -y || $a == --yes ]]; then assume_yes=1; else args+=("$a"); fi
      [[ $a == -- ]] && passthru=1
    done
  fi
  set -- ${args[@]+"${args[@]}"}
  if [[ $verb != sync ]]; then
    env_root=$(mktemp -d "${TMPDIR:-/tmp}/stacks-env.XXXXXX")
    trap 'rm -rf "$env_root"' EXIT
    trap 'exit 130' INT TERM
  fi
  case $verb in
    ctx) cmd_ctx ;;
    doctor) cmd_doctor ;;
    bootstrap) cmd_bootstrap ;;
    sync) cmd_sync "$@" ;;
    *) run_compose "$verb" "$@" ;;
  esac
}

# Bash parses the whole group before running it, so edits to this file during a long run are never read.
{
  main "$@"
  exit
}
