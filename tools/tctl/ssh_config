# Technis stack hosts, included first from ~/.ssh/config by `tctl bootstrap`.

# Off the home LAN, nexus and stargate fall back to their Tailscale addresses.

Match originalhost nexus !exec "nc -z -w 1 192.168.1.3 22"
HostName 100.100.1.3
Match originalhost stargate !exec "nc -z -w 1 192.168.1.2 22"
HostName 100.100.1.2

Host nexus
HostName 192.168.1.3
HostKeyAlias nexus
Host stargate
HostName 192.168.1.2
HostKeyAlias stargate
Host mothership
HostName 100.100.1.1
HostKeyAlias mothership

Host nexus stargate mothership
User root
IdentityFile ~/.ssh/technis
IdentitiesOnly yes
StrictHostKeyChecking accept-new
ControlMaster auto
ControlPath ~/.ssh/cm-%C
ControlPersist 5m
ServerAliveInterval 15
