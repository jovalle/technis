{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "technis-path-router",
  "main": "path-router.mjs",
  "account_id": "ce9155e68908072f718b1241bc61cb98",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.svg"], "fallthrough": true }],
  "routes": [
    {
      "pattern": "techn.is/dashboard*",
      "zone_name": "techn.is",
    },
    {
      "pattern": "techn.is/req*",
      "zone_name": "techn.is",
    },
    {
      "pattern": "techn.is/request*",
      "zone_name": "techn.is",
    },
    {
      "pattern": "techn.is/requests*",
      "zone_name": "techn.is",
    },
    {
      "pattern": "techn.is/logo*",
      "zone_name": "techn.is",
    },
    {
      "pattern": "techn.is/favicon*",
      "zone_name": "techn.is",
    },
    {
      "pattern": "dash.techn.is/*",
      "zone_name": "techn.is",
    },
    {
      "pattern": "req.techn.is/*",
      "zone_name": "techn.is",
    },
    {
      "pattern": "request.techn.is/*",
      "zone_name": "techn.is",
    },
    {
      "pattern": "requests.techn.is/*",
      "zone_name": "techn.is",
    },
    {
      "pattern": "photos.ovall.es/*",
      "zone_name": "ovall.es",
    },
    {
      "pattern": "photos.techn.is/api/auth/login",
      "zone_name": "techn.is",
    },
  ],
}
