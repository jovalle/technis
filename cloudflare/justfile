set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

account_id := "ce9155e68908072f718b1241bc61cb98"

# List available recipes.
default:
    @{{ just_executable() }} --list

# Install locked dependencies.
install:
    bun install --frozen-lockfile

# Update dependencies within their declared ranges.
update:
    bun update

# Bundle the Worker without uploading it.
lint:
    CLOUDFLARE_ACCOUNT_ID={{ account_id }} bunx wrangler deploy --dry-run

# Deploy the path-router Worker and its routes. Extra args go to wrangler.
deploy *args:
    CLOUDFLARE_ACCOUNT_ID={{ account_id }} bunx wrangler deploy "$@"
